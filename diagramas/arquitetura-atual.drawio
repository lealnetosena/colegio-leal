        <mxCell id="_ZsJgNjbeAwcy8B0wdT2-67" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Área Interna" vertex="1">
