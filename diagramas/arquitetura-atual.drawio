        <mxCell id="__C-Crx1-3bfwy97gMmu-73" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=14;" value="1.1 Job automático executa todo dia 1 e aciona a Procedure CalculaFatura (legado, sem mudança)&lt;div&gt;1.2 CalculaFatura executa os cálculos e salva o resultado na TbFatura (legado, sem mudança)&lt;/div&gt;&lt;div&gt;1.3 Job Verifica Fatura (novo, Spring Batch) lê a TbFatura periodicamente, procurando faturas prontas&lt;/div&gt;&lt;div&gt;1.4 Job Verifica Fatura publica fatura.pronta&lt;/div&gt;&lt;div&gt;1.5 Job Finaliza Calculo consome fatura.pronta&lt;/div&gt;&lt;div&gt;1.6 Job Finaliza Calculo aciona a Procedure GeraFaturaFinal — só o pedaço do cálculo final (o 1.2 dela), que hoje roda no clique do aluno&lt;/div&gt;&lt;div&gt;1.7 Job Finaliza Calculo publica fatura.finalizada&lt;/div&gt;&lt;div&gt;1.8 Atom persiste Fatura consome fatura.finalizada&lt;/div&gt;&lt;div&gt;1.9 Atom persiste Fatura grava o resultado, insert-only, no DBNovo/TbFaturaFinal — histórico completo, nunca sobrescreve&lt;/div&gt;&lt;div style=&quot;color:#666666;font-style:italic;margin-top:8px;&quot;&gt;O legado (1.1-1.2) continua do jeito que já funciona — só passa a ser observado por fora, sem nenhuma mudança de código nele&lt;/div&gt;" vertex="1">
          <mxGeometry height="420" width="310" x="865" y="1474" as="geometry" />
        </mxCell>
