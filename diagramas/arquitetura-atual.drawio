        <mxCell id="_ZsJgNjbeAwcy8B0wdT2-70" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=14;" value="1.1 Job automático executa todo dia 1 e chama a procedure CalculaFatura&lt;div&gt;1.2 CalculaFatura executa todos os cálculos e salva na TbFatura&lt;/div&gt;" vertex="1">
