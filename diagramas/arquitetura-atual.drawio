        <mxCell id="_ZsJgNjbeAwcy8B0wdT2-74" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1.2" vertex="1">
